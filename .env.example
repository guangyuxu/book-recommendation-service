# Copy to .env and adjust. .env is git-ignored.

# --- Database (shared with the agent's Postgres; same tooling) ---
# Local (docker compose db service): postgres on localhost:5432
BOOK_AGENT_DATABASE_URL=postgresql+psycopg://book:book@localhost:5432/book?options=-csearch_path%3Dbook_agent
# Under docker compose, reach the db service by name instead:
# BOOK_AGENT_DATABASE_URL=postgresql+psycopg://book:book@db:5432/book?options=-csearch_path%3Dbook_agent

# --- Auth ---
# Local development ONLY. Turns on the fixed-identity dev stub. Never enable in a deployed env.
DEV_AUTH=1
# Optional overrides for the dev identity (defaults match the agent's AppContext):
# DEV_FAMILY_ID=16555532-69b5-411e-8526-e0b321fbcfea
# DEV_FAMILY_MEMBER_ID=659c1323-f47a-40eb-a0fe-5fb83f47c9c9
# DEV_CHILD_ID=d63ae622-797b-4a1c-ae88-9c4309fb3b3a

# --- Upstream agent (LangGraph server) ---
AGENT_URL=http://localhost:2024

# --- HTTP / CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
