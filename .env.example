# Copy to .env and adjust. .env is git-ignored.

# The BFF verifies tokens (RS256 public key) and proxies chat. It holds NO database connection and
# NO private key — auth issuance and family/child CRUD live in the accounts service.

# --- Auth ---
# Local development ONLY. Turns on the fixed-identity dev stub. Never enable in a deployed env.
DEV_AUTH=1
# Optional overrides for the dev identity (defaults match the agent's AppContext):
# DEV_FAMILY_ID=16555532-69b5-411e-8526-e0b321fbcfea
# DEV_FAMILY_MEMBER_ID=659c1323-f47a-40eb-a0fe-5fb83f47c9c9
# DEV_CHILD_ID=d63ae622-797b-4a1c-ae88-9c4309fb3b3a

# --- Token verification (RS256) ---
# The accounts service's PUBLIC key. REQUIRED (non-dev). Provide inline via JWT_PUBLIC_KEY or a
# path via JWT_PUBLIC_KEY_PATH (e.g. point it at the accounts repo's keys/public.pem in local dev).
# JWT_PUBLIC_KEY_PATH=../book-recommendation-accounts/keys/public.pem
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Claims contract (must match the accounts issuer):
JWT_ISSUER=book-recommendation-accounts
JWT_AUDIENCE=book-recommendation
# JWT_ALGORITHM=RS256

# --- Upstream agent (LangGraph server) ---
AGENT_URL=http://localhost:2024
# AGENT_GRAPH_NAME=agent

# --- Accounts service (identity provider + CRUD) ---
ACCOUNTS_URL=http://localhost:8001

# --- HTTP / CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
